# ==============================================================================
# VISION AI — ENVIRONMENT CONFIGURATION
# Copy this file to .env for local Docker Compose development.
# Do NOT commit the actual .env file.
# ==============================================================================

# ─── FRONTEND ─────────────────────────────────────────────────────────────
# Local development base URL. In production, this should point to
# the live backend URL .
VITE_API_URL="http://localhost:8080"

# ─── BACKEND ──────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# Session security (generate a secure 32+ char string for production)
SESSION_SECRET="replace_me_with_a_secure_minimum_32_character_secret_for_local_dev"
SESSION_MAX_AGE_MS=86400000

# CORS & Proxy
ALLOWED_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
TRUST_PROXY="false" 

# Inference
INFERENCE_SERVICE_URL="http://inference:8000"

# Database (used by Docker Compose & Prisma)
POSTGRES_USER="visionai"
POSTGRES_PASSWORD="visionai_dev"
POSTGRES_DB="visionai_auth"
DATABASE_URL="postgresql://visionai:visionai_dev@database:5432/visionai_auth"

# Storage
# Base directory for storing uploaded retinal images and generated clinical PDF reports.
# Mounted to persistent Docker volume 'uploads' at /app/uploads in docker-compose.
STORAGE_BASE_PATH="/app/uploads"

# Clinical Safety / Demonstration Mode
# WARNING: MUST be set to "false" (or omitted) in all production and clinical testing environments.
# When set to "true", hardcoded demonstration results override actual AI inference for UI presentations.
PRESENTATION_DEMO_MODE="false"

# Optional Services
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vision AI Platform <noreply@visionai.health>"
