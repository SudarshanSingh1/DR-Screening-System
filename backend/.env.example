# ─── Server Configuration ──────────────────────────────────────────────────
PORT=8080
NODE_ENV=production

# ─── Database ─────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?sslmode=require
DATABASE_URL=

# ─── Inference Service ─────────────────────────────────────────────────────
# URL of the internal inference service
INFERENCE_SERVICE_URL=https://visionai-inference.onrender.com

# ─── Session Security ─────────────────────────────────────────────────────
# MUST be a randomly generated string of at least 32 characters in production.
SESSION_SECRET=
# Lifetime of the session in milliseconds (default: 24h = 86400000)
SESSION_MAX_AGE_MS=86400000

# ─── Network & CORS ───────────────────────────────────────────────────────
# The exact origin of the frontend. Used to validate cross-origin requests.
ALLOWED_ORIGIN=https://visionai-frontend.onrender.com
# Used for email links.
FRONTEND_URL=https://visionai-frontend.onrender.com
# Configure reverse proxy trust for rate limiters.
# Set to '1' if behind Render proxy / ALB.
TRUST_PROXY="1"

# ─── Optional: OTP Provider (MSG91) ───────────────────────────────────────
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# ─── Optional: Email / SMTP ───────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vision AI Platform <noreply@visionai.health>"

# ─── Optional: Government Identity Providers ──────────────────────────────
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=https://visionai-backend.onrender.com/api/auth/digilocker/callback

MERI_PEHCHAAN_CLIENT_ID=
MERI_PEHCHAAN_CLIENT_SECRET=
MERI_PEHCHAAN_REDIRECT_URI=https://visionai-backend.onrender.com/api/auth/meri-pehchaan/callback
