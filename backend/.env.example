# ─── Server Configuration ──────────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────
# PostgreSQL container initialization (only used on first container start)
POSTGRES_USER="visionai"
POSTGRES_PASSWORD="visionai_dev"
POSTGRES_DB="visionai_auth"

# Internal docker topology uses hostname 'database'
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL="postgresql://visionai:visionai_dev@database:5432/visionai_auth"

# ─── Session Security ─────────────────────────────────────────────────────
# MUST be a randomly generated string of at least 32 characters in production.
# Example generator: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace_me_with_a_secure_minimum_32_character_secret_for_local_dev"
# Lifetime of the session in milliseconds (default: 24h = 86400000)
SESSION_MAX_AGE_MS=86400000

# ─── Network & CORS ───────────────────────────────────────────────────────
# The exact origin of the frontend. Used to validate cross-origin requests.
ALLOWED_ORIGIN="http://localhost:3000"
# Used for email links.
FRONTEND_URL="http://localhost:3000"
# Configure reverse proxy trust for rate limiters.
# Set to 'false' for direct exposure or local docker. Set to '1' if behind Nginx/ALB.
TRUST_PROXY="false"

# ─── Optional: OTP Provider (MSG91) ───────────────────────────────────────
# If left blank, OTP endpoints safely degrade to return 503 errors.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# ─── Optional: Email / SMTP ───────────────────────────────────────────────
# If left blank, Password Reset gracefully handles the missing provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vision AI Platform <noreply@visionai.health>"

# ─── Optional: Government Identity Providers ──────────────────────────────
# If left blank, verification endpoints safely return 503 errors.
# DigiLocker
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI="http://localhost:8080/api/auth/digilocker/callback"

# Meri Pehchaan
MERI_PEHCHAAN_CLIENT_ID=
MERI_PEHCHAAN_CLIENT_SECRET=
MERI_PEHCHAAN_REDIRECT_URI="http://localhost:8080/api/auth/meri-pehchaan/callback"
